# URL da API com o prefixo /v1.
# - Navegador (npm run web) e simulador iOS: http://localhost:8080/v1
# - Emulador Android: http://10.0.2.2:8080/v1
# - Celular físico (Expo Go): use o IP da sua máquina na rede, ex.: http://192.168.1.4:8080/v1
EXPO_PUBLIC_API_URL=http://localhost:8080/v1

# Servidor de duelo (aba Duelo). Mesma regra da API: no emulador Android use http://10.0.2.2:8787 e, no celular físico, o IP da máquina.
EXPO_PUBLIC_DUEL_URL=http://localhost:8787
# Prefixo das imagens das cartas (por padrão deriva da API: <API>/images). Em celular físico precisa do IP da máquina.
# EXPO_PUBLIC_IMAGE_BASE_URL=http://192.168.1.4:8080/images
