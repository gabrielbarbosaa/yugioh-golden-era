PORT=8080
LOG_LEVEL=info
DATABASE_URL=postgres://golden:golden@localhost:5432/golden_era?sslmode=disable
IMAGE_BASE_URL=http://localhost:8080/images
IMAGES_DIR=.data/images
MIGRATE_ON_START=false
