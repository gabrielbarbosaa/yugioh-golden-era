# Copie para .env.production (que o git ignora) e preencha. Usado com:
#   docker compose -f docker-compose.prod.yml --env-file .env.production ...

# Domínio público (sem https://). É ele que entra nas URLs de imagem, no WebSocket e no CORS.
DOMAIN=novaera.gabrielbarbosadev.com.br

# Banco. Troque a senha (não precisa lembrar: só os containers a usam).
POSTGRES_USER=golden
POSTGRES_DB=golden_era
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# Segredo dos tokens de login: 32+ caracteres aleatórios. Gere com:  openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-aleatorio-com-64-hex

# Portas locais (127.0.0.1) para o proxy. Mude se alguma já estiver em uso na VPS.
API_PORT=18080
DUEL_PORT=18787
WEB_PORT=13000

# Pasta das imagens das cartas (relativa à raiz do repositório, ou absoluta).
IMAGES_PATH=./.data/images