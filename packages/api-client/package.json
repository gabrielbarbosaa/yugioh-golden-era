{
  "name": "@golden-era/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Cliente TypeScript tipado da API do Golden Era, gerado de api/openapi.yaml.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../api/openapi.yaml -o src/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/index.test.ts"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.0",
    "typescript": "~5.9.2"
  }
}
